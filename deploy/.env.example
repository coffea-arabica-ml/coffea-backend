# Modelo do deploy/.env, lido pelo docker compose na pasta deploy/. Copie para deploy/.env (fora do
# git) e preencha. Nunca versione o deploy/.env.

# Domínio da API: o registro DNS A dele aponta para o servidor. Na validação local: localhost.
DOMINIO=api.coffealab.tech

# Origens do navegador liberadas no CORS: a URL exata do coffea-web na Vercel, como aparece na barra
# do navegador, sem barra no fim. Mais de uma: separadas por vírgula. O backend não sobe enquanto o
# marcador abaixo estiver aqui. Na validação local: http://localhost:5173
COFFEA_CORS_ORIGENS=<URL_DO_COFFEA_WEB_NA_VERCEL>

# Commits dos dois clones (a imagem vira cafelens-api:<backend>-<ml>). Para preencher, na pasta deploy/:
#   sed -i "s/^COMMIT_BACKEND=.*/COMMIT_BACKEND=$(git -C .. rev-parse --short HEAD)/; s/^COMMIT_ML=.*/COMMIT_ML=$(git -C ../../coffea-ml rev-parse --short HEAD)/" .env
COMMIT_BACKEND=
COMMIT_ML=

# UID e GID de quem roda a API dentro do contêiner: os do usuário deploy (id -u; id -g), dono da
# pasta dados/.
APP_UID=1000
APP_GID=1000

# Pasta do coffea.db e dos backups, fora dos repositórios (padrão: ../../dados, isto é,
# /opt/cafelens/dados).
# DADOS_DIR=../../dados
